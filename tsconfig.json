{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "checkJs": false,
    "allowJs": true,
    "strict": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "*": ["types/*"]
    }
  },
  "include": [
    "js/**/*",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    "Vocab Vault.app",
    "vocab-vault-web"
  ]
}
